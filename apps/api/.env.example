NODE_ENV=development
PORT=3001

CORS_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false

DATABASE_URL="postgresql://meridian:MERIDIAN_PASSWORD@127.0.0.1:5433/meridian?schema=public"
DIRECT_URL="postgresql://meridian:MERIDIAN_PASSWORD@127.0.0.1:5433/meridian?schema=public"

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=MeridianTravelPlanner/0.1

PASSWORD_RESET_TTL_MINUTES=20

# Local development uses Mailpit over SMTP.
# Production on Render should use Mailjet's HTTPS API instead.
MAIL_PROVIDER=smtp

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Meridian <no-reply@meridian.local>

# Used only when MAIL_PROVIDER=mailjet.
MAILJET_API_URL=https://api.mailjet.com/v3.1/send
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Meridian

# Redis cache
REDIS_URL=redis://localhost:6379
CACHE_GEOCODING_TTL_SECONDS=86400
CACHE_WEATHER_LOCATION_TTL_SECONDS=604800
CACHE_WEATHER_FORECAST_TTL_SECONDS=900

# BullMQ background jobs
QUEUE_ENABLED=false
QUEUE_REDIS_URL=redis://localhost:6380
QUEUE_PAYLOAD_ENCRYPTION_KEY=
