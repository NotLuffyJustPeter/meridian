NODE_ENV=development
PORT=3001

CORS_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Runtime connection. In Neon production, prefer the pooled connection string.
DATABASE_URL="postgresql://meridian:MERIDIAN_PASSWORD@127.0.0.1:5433/meridian?schema=public"

# Prisma CLI / migrations. In Neon production, use the direct (non-pooled) connection string.
# If omitted, Prisma CLI falls back to DATABASE_URL.
DIRECT_URL="postgresql://meridian:MERIDIAN_PASSWORD@127.0.0.1:5433/meridian?schema=public"

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=MeridianTravelPlanner/0.1

PASSWORD_RESET_TTL_MINUTES=20

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Meridian <no-reply@meridian.local>
