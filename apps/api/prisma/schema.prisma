// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  GOOGLE
}

enum TripStatus {
  DRAFT
  PLANNED
  ARCHIVED
}

enum TripMemberRole {
  EDITOR
  VIEWER
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  TRANSPORT
  LODGING
  SHOPPING
  ENTERTAINMENT
  OTHER
}

enum PlaceCategory {
  LANDMARK
  FOOD
  LODGING
  SHOPPING
  TRANSPORT
  ENTERTAINMENT
  NATURE
  OTHER
}

enum ExpenseCategory {
  ACCOMMODATION
  FOOD
  TRANSPORT
  ACTIVITIES
  SHOPPING
  HEALTH
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authSessions    AuthSession[]
  identities      AuthIdentity[]
  totpCredential  TotpCredential?
  mfaChallenges       MfaChallenge[]
  passwordResetTokens   PasswordResetToken[]
  trips                 Trip[]
  tripMemberships TripMember[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthIdentity {
  id              String       @id @default(uuid())
  userId          String
  provider        AuthProvider
  providerSubject String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_identities")
}


model TotpCredential {
  id                  String    @id @default(uuid())
  userId              String    @unique
  secretCiphertext    String
  secretIv            String
  secretAuthTag       String
  enabledAt           DateTime?
  lastUsedTotpCounter Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@index([userId, enabledAt])
  @@map("totp_credentials")
}

model MfaRecoveryCode {
  id           String    @id @default(uuid())
  credentialId String
  codeHash     String
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  credential TotpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, codeHash])
  @@index([credentialId, usedAt])
  @@map("mfa_recovery_codes")
}

model MfaChallenge {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, consumedAt])
  @@map("mfa_challenges")
}



model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

model Trip {
  id          String     @id @default(uuid())
  ownerId     String
  name        String
  destination String
  startDate   DateTime
  endDate     DateTime
  timezone    String
  currency    String
  status      TripStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner    User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members  TripMember[]
  days     TripDay[]
  places   Place[]
  budget   Budget?
  expenses Expense[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, startDate])
  @@map("trips")
}

model TripDay {
  id        String   @id @default(uuid())
  tripId    String
  date      DateTime
  dayNumber Int
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([tripId, dayNumber])
  @@unique([tripId, date])
  @@index([tripId])
  @@index([tripId, date])
  @@map("trip_days")
}

model Activity {
  id          String           @id @default(uuid())
  tripDayId   String
  placeId     String?
  title       String
  description String?
  category    ActivityCategory @default(OTHER)
  startTime   String?
  endTime     String?
  location    String?
  notes       String?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tripDay TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([tripDayId])
  @@index([placeId])
  @@index([tripDayId, position])
  @@map("activities")
}

model Place {
  id             String        @id @default(uuid())
  tripId         String
  name           String
  category       PlaceCategory @default(OTHER)
  address        String?
  latitude       Float?
  longitude      Float?
  notes          String?
  website        String?
  sourceProvider String?
  sourcePlaceId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([tripId])
  @@index([tripId, category])
  @@index([tripId, name])
  @@index([tripId, sourceProvider, sourcePlaceId])
  @@map("places")
}

model Budget {
  id          String   @id @default(uuid())
  tripId      String   @unique
  totalAmount Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip           Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  categoryLimits BudgetCategoryLimit[]

  @@index([tripId])
  @@map("budgets")
}

model BudgetCategoryLimit {
  id        String          @id @default(uuid())
  budgetId  String
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(14, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
  @@index([budgetId])
  @@index([budgetId, category])
  @@map("budget_category_limits")
}

model Expense {
  id        String          @id @default(uuid())
  tripId    String
  title     String
  category  ExpenseCategory @default(OTHER)
  amount    Decimal         @db.Decimal(14, 2)
  spentAt   DateTime
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([tripId, category])
  @@index([tripId, spentAt])
  @@map("expenses")
}

model TripMember {
  id        String         @id @default(uuid())
  tripId    String
  userId    String
  role      TripMemberRole @default(EDITOR)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([userId, role])
  @@map("trip_members")
}
